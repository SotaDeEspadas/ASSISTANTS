# ============================================================================
# CONFIGURACIÓN DE AUTENTICACIÓN - Microsoft Entra ID (Azure AD)
# ============================================================================
# Obtén estos valores del registro de la aplicación en Azure Portal
# https://portal.azure.com -> Azure Active Directory -> App registrations
VITE_AZURE_AD_CLIENT_ID=tu_client_id_aqui
VITE_AZURE_AD_TENANT_ID=tu_tenant_id_aqui
VITE_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# ============================================================================
# CONFIGURACIÓN DE API
# ============================================================================
# URL base del backend API (Azure Functions o App Service)
VITE_API_BASE_URL=http://localhost:3000/api

# ============================================================================
# CONFIGURACIÓN DE DATVERSE
# ============================================================================
# URL del entorno de Dataverse
VITE_DATVERSE_URL=https://tu-organizacion.crm.dynamics.com

# ============================================================================
# CONFIGURACIÓN DE BMRED (opcional)
# ============================================================================
# Si se usa conexión directa a BMred
VITE_BMRED_API_URL=https://bmred.bancomediolanum.es/api
VITE_BMRED_USERNAME=tu_usuario
VITE_BMRED_PASSWORD=tu_contraseña

# ============================================================================
# CONFIGURACIÓN DE SHAREPOINT (opcional)
# ============================================================================
# Para almacenamiento de documentos
VITE_SHAREPOINT_SITE_URL=https://bancomediolanum.sharepoint.com/sites/ASSISTANTS
VITE_SHAREPOINT_CLIENT_ID=tu_client_id
VITE_SHAREPOINT_CLIENT_SECRET=tu_client_secret

# ============================================================================
# CONFIGURACIÓN DE AZURE STORAGE (opcional)
# ============================================================================
# Para almacenamiento de archivos
VITE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=tucuenta;AccountKey=tuclave;EndpointSuffix=core.windows.net
VITE_AZURE_STORAGE_CONTAINER=assistants-documents

# ============================================================================
# CONFIGURACIÓN DE MONITORIZACIÓN (opcional)
# ============================================================================
# Application Insights
VITE_APP_INSIGHTS_INSTRUMENTATION_KEY=tu_instrumentation_key
